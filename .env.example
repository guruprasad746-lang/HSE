# Copy to .env and fill in. Never commit .env.

# Atlas: Cluster0 > Connect > Drivers. Create a database user first and add
# your machine's IP to the project's Network Access list.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.az7tmxc.mongodb.net/?retryWrites=true&w=majority&appName=hse-chatbot
MONGODB_DB=hse
MONGODB_COLLECTION=incidents

# Claude API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
